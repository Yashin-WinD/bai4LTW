<?xml version="1.0" encoding="UTF-8"?>
<web-app>
	<filter>
		<filter-name>noCache</filter-name>
		<filter-class>vn.ute.filter.NoCacheFilter</filter-class>
	</filter>

	<filter-mapping>
		<filter-name>noCache</filter-name>
		<url-pattern>/*</url-pattern>
	</filter-mapping>

	<filter>
		<filter-name>sitemesh</filter-name>
		<filter-class>
			org.sitemesh.config.ConfigurableSiteMeshFilter
		</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>sitemesh</filter-name>
		<url-pattern>/*</url-pattern>
	</filter-mapping>
</web-app>